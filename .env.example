# Get a free key from https://aistudio.google.com/apikey (Google account, no card needed)
GEMINI_API_KEY=paste-your-key-here

# Brand-name search. Free key (1,000 searches a month, no card) from https://app.tavily.com
TAVILY_API_KEY=paste-your-key-here

# Zomato ratings on Vercel, where Zomato blocks direct requests. Free token ($5 credit a month, no card) from
# https://console.apify.com/settings/integrations. Leave it commented out locally and the app reads Zomato directly.
# APIFY_TOKEN=paste-your-token-here

# Prices from Google Shopping, the one price source that works from a cloud host.
# Free key (2,500 searches, one-off, no card) from https://serper.dev - the app skips this source without it.
# SERPER_API_KEY=paste-your-key-here

# Port for the local server (optional)
PORT=3000
